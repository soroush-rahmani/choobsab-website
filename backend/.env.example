# ═══════════════════════════════════════════════
#  نمونه فایل تنظیمات — این فایل را به «.env» کپی کنید و مقادیر را پر کنید
#  فایل .env هرگز نباید در گیت/آپلود قرار بگیرد (شامل مرچنت‌کد است)
# ═══════════════════════════════════════════════

# حالت درگاه زرین‌پال:
#   true  = سندباکس (تستی — پول واقعی جابه‌جا نمی‌شود)
#   false = درگاه واقعی (فقط وقتی دامنه + HTTPS + مرچنت‌کد واقعی آماده است)
ZARINPAL_SANDBOX=true

# کد مرچنت از پنل zarinpal.com — فقط برای حالت واقعی لازم است
ZARINPAL_MERCHANT=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# پورت سرور (پیش‌فرض 5000)
PORT=5000
