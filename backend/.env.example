# ═══════════════════════════════════════════════
#  نمونه فایل تنظیمات — این فایل را به «.env» کپی کنید و مقادیر را پر کنید
#  فایل .env هرگز نباید در گیت/آپلود قرار بگیرد (شامل مرچنت‌کد است)
# ═══════════════════════════════════════════════

# حالت درگاه زرین‌پال:
#   true  = سندباکس (تستی — پول واقعی جابه‌جا نمی‌شود)
#   false = درگاه واقعی (فقط وقتی دامنه + HTTPS + مرچنت‌کد واقعی آماده است)
ZARINPAL_SANDBOX=true

# کد مرچنت از پنل zarinpal.com — فقط برای حالت واقعی لازم است
ZARINPAL_MERCHANT=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── ملی پیامک (اختیاری — اتصال اس‌ام‌اس ورود و سفارش) ───
# از پنل melipayamak.com → «وب‌سرویس» → «کلید وب سرویس» (Web Service Key)
MELIPAYAMAK_USERNAME=username
MELIPAYAMAK_PASSWORD=web-service-key
# شماره خط ارسال (فقط برای حالت «ارسال ساده») — برای حالت الگویی الزامی نیست:
# MELIPAYAMAK_FROM=5000xxxx
# کد الگوها (هر الگوی تأییدشده یک عدد ۶ رقمی bodyId دارد):
MELIPAYAMAK_BODY_ID_OTP=123456
MELIPAYAMAK_BODY_ID_ORDER=123456

# پورت سرور (پیش‌فرض 5000)
PORT=5000
